{
  "name": "ekam-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "nodemon --watch src --ext ts,tsx,css,html --exec \"vite --port 5173\"",
    "dev": "nodemon --watch src --ext ts,tsx,css,html --exec \"vite --port 5173\"",
    "dev:vite": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5174",
    "lint": "echo \"add eslint later\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
