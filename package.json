    "axios": "^1.12.2",
    "canvas-confetti": "^1.9.4",
    "exceljs": "^4.4.0",
    "firebase": "^12.13.0",
    "framer-motion": "^12.23.24",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
